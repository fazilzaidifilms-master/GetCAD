# GetCAD environment template. Copy to `.env.local` and fill in.
# NEVER commit real values. NEVER put a secret behind NEXT_PUBLIC_*.

# --- Clerk -> Supabase bridge (slice 3) ---
# Public, non-secret. Your Clerk Frontend API origin (the "Clerk Domain" you
# registered in Supabase -> Authentication -> Third-Party Auth).
#   dev:  https://your-app-xxxx.clerk.accounts.dev
#   prod: https://clerk.yourdomain.com
CLERK_JWT_ISSUER=

# Optional. Defaults to ${CLERK_JWT_ISSUER}/.well-known/jwks.json
# CLERK_JWKS_URL=

# --- Clerk app keys (login UI slice) ---
# Publishable key is PUBLIC (ships to the browser). Secret key is SERVER-ONLY —
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase client (login UI slice) ---
# URL and ANON key are PUBLIC by design (protected by RLS). Service-role key is
# a SECRET, server-only — never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret (bypasses RLS) — used for Storage writes + signed URLs.
# Never NEXT_PUBLIC_. Supabase → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (migrations / local tests) ---
# Used by `npm run db:apply` and the DB tests. For live Supabase use the
# Session pooler (IPv4) string; locally point at your throwaway Postgres.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# --- Marketing site SEO (slice: marketing site) ---
# Public, non-secret. Your production domain (no trailing slash) — used to build
# canonical/OG URLs and sitemap.xml. Optional; defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://thecadpillar.com

# --- Server Actions (slice 28) ---
# Comma-separated extra origins trusted for Server Actions. Only needed if your
# production host proxies them from a different origin. Dev hosts (localhost,
# *.app.github.dev) are trusted automatically OUTSIDE production and must never
# be trusted in production.
# NEXT_SERVER_ACTION_ALLOWED_ORIGINS=app.yourdomain.com

# --- Rate limiting (slice 28) ---
# Salt for hashing client IPs before they reach the database (no raw IP is ever
# stored). Set a random value in production so digests are not guessable.
# RATE_LIMIT_SALT=

# --- Razorpay (slice 32: payment collection) ---
# Key id is PUBLIC (ships to the browser to open checkout). Both secrets are
# SERVER-ONLY — never prefix either with NEXT_PUBLIC_.
# The WEBHOOK secret is a DIFFERENT value from the key secret: Razorpay signs
# webhooks with the former, checkout callbacks with the latter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (transactional) -------------------------------------------------
# OPTIONAL. With these unset the app still runs: acknowledgement emails queue
# in the outbox and send once configured (nothing is lost). Provider is Resend;
# EMAIL_FROM must be a sender on a domain verified with the provider.
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Where human replies land; defaults to EMAIL_FROM.
# EMAIL_REPLY_TO=
